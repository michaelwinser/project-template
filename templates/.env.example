# Server configuration
PORT=8080
HOST=localhost

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback

# Session
SESSION_SECRET=change-this-to-a-random-string

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Environment
ENV=development
